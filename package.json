{
  "name": "calculadora-rendimentos",
  "version": "1.0.0",
  "description": "Gestão de carteiras em Next.js, React e TypeScript",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --config config/eslint.config.mjs .",
    "format": "prettier --config config/prettier.config.json --write",
    "format:check": "prettier --config config/prettier.config.json --check",
    "format:check:changed": "node scripts/check-format.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/unit/*.test.mjs tests/integration/*.test.ts tests/integration/*.test.mjs",
    "test:e2e": "playwright test --config=config/playwright.config.ts",
    "test:e2e:supabase-real": "node scripts/test-e2e-supabase-real.mjs",
    "test:sql": "node --import tsx supabase/tests/check-migration.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/speed-insights": "^2.1.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "yahoo-finance2": "4.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "private": true,
  "engines": {
    "node": "26.x"
  }
}
